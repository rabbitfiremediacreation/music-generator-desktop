{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Desktop window and native selection dialogs",
  "windows": ["main"],
  "permissions": [
    "core:default", "core:window:allow-minimize", "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging", "core:window:allow-close",
    "dialog:allow-open", "dialog:allow-save", "dialog:allow-confirm", "dialog:allow-message",
    { "identifier": "opener:allow-open-url", "allow": [
      { "url": "https://github.com/**" },
      { "url": "https://alphatester.rabbitfire.de/**" },
      { "url": "https://www.nvidia.com/Download/index.aspx" },
      { "url": "https://huggingface.co/**" },
      { "url": "https://www.apache.org/licenses/LICENSE-2.0" },
      { "url": "https://creativecommons.org/licenses/by-nc/4.0/" },
      { "url": "https://www.gnu.org/licenses/gpl-3.0.html" },
      { "url": "https://opensource.org/license/mit" }
    ] }
  ]
}
