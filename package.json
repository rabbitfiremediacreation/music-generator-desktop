{
  "name": "music-generator-desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node --test scripts/desktop/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "engine:prepare": "node scripts/desktop/prepare-engine.mjs",
    "bundle": "node scripts/desktop/build.mjs",
    "tauri": "tauri",
    "lint": "eslint frontend"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
