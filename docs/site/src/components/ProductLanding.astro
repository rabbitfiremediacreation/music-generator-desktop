---
import { Image } from "astro:assets";
import studio from "../../../../assets/music-generator-overview.png";
import { landingCopy } from "../data/landing";
import { desktopRelease, type Locale } from "../data/releases";
import Brand from "./Brand.astro";
import Downloads from "./Downloads.astro";
import "../styles/landing.css";

const locale: Locale = Astro.locals.starlightRoute.lang === "en" ? "en" : "de";
const copy = landingCopy[locale];
const root = import.meta.env.BASE_URL;
const home = `${root}${locale}/`;
const guide = `${home}guides/installation/`;
const repo = "https://github.com/rabbitfiremediacreation/music-generator-desktop";
---
<div class="product-page">
  <header class="product-header">
    <Brand href={home} />
    <nav class="product-nav" aria-label={locale === "de" ? "Hauptnavigation" : "Main navigation"}>
      <a href="#studio">{copy.nav[0]}</a><a href="#workflow">{copy.nav[1]}</a><a href="#download">{copy.nav[2]}</a><a href={guide}>{copy.nav[3]} <span aria-hidden="true">↗</span></a>
    </nav>
    <div class="product-header-actions">
      <nav class="language-links" aria-label={copy.language}><a href={`${root}de/`} lang="de" hreflang="de" aria-current={locale === "de" ? "page" : undefined}>DE</a><span aria-hidden="true">/</span><a href={`${root}en/`} lang="en" hreflang="en" aria-current={locale === "en" ? "page" : undefined}>EN</a></nav>
      <a class="header-download" href="#download">{copy.nav[2]} <span aria-hidden="true">↓</span></a>
    </div>
  </header>

  <main id="_top" data-pagefind-body>
    <section id="studio" class="product-hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span>{copy.eyebrow}</p>
        <h1 id="hero-title">{copy.headline[0]}<br /><span>{copy.headline[1]}</span></h1>
        <p class="hero-intro">{copy.intro}</p>
        <div class="hero-actions"><a class="primary-button" href="#download">{copy.download} <span aria-hidden="true">↓</span></a><a class="hero-guide" href={guide}>{copy.guide} <span aria-hidden="true">↗</span></a></div>
        <p class="hero-note">{copy.heroNote}</p>
      </div>
      <figure class="hero-product">
        <div class="record-art" aria-hidden="true"><span>MG</span></div>
        <div class="product-image-wrap">
          <div class="image-label"><span class="status-dot"></span>MUSIC GENERATOR <span>DESKTOP STUDIO</span></div>
          <button class="product-shot" data-open-studio aria-label={copy.enlarge} aria-haspopup="dialog">
            <Image src={studio} alt={copy.imageAlt} widths={[720, 1080, 1600]} sizes="(max-width: 800px) 100vw, 65vw" format="webp" quality={88} loading="eager" fetchpriority="high" />
            <span class="zoom-mark" aria-hidden="true">↗</span>
          </button>
          <div class="image-caption"><span>{copy.imageCaption}</span><span>01 / STUDIO</span></div>
        </div>
        <figcaption>{copy.imageSource}</figcaption>
      </figure>
    </section>

    <div class="product-facts">{copy.facts.map(([title, text], i) => <div><span class="fact-number">0{i + 1}</span><p><strong>{title}</strong><span>{text}</span></p></div>)}</div>

    <section id="workflow" class="workflow-section product-section" aria-labelledby="workflow-title">
      <div class="section-heading"><p class="eyebrow">{copy.workflowLabel}</p><h2 id="workflow-title">{copy.workflowTitle}</h2><p class="section-intro">{copy.workflowIntro}</p></div>
      <ol class="workflow-steps">{copy.steps.map(([title, body], i) => <li><span class="step-number">0{i + 1}</span><h3>{title}</h3><p>{body}</p></li>)}</ol>
    </section>

    <section class="library-section product-section" aria-labelledby="library-title">
      <figure class="library-product">
        <div class="library-image-crop"><Image src={studio} alt={copy.detailAlt} width={1400} format="webp" quality={88} loading="lazy" /></div>
        <figcaption><span>{copy.detailCaption}</span><span>{copy.detailSource}</span></figcaption>
      </figure>
      <div class="library-copy"><p class="eyebrow">{copy.detailLabel}</p><h2 id="library-title">{copy.detailTitle}</h2><p>{copy.detailBody}</p><a class="text-link" href={`${guide}#${locale === "de" ? "daten-sichern-und-aktualisieren" : "back-up-data-and-update"}`}>{copy.detailLink} <span aria-hidden="true">↗</span></a></div>
    </section>

    <Downloads locale={locale} />

    <section class="docs-section product-section" aria-labelledby="docs-title">
      <div><p class="eyebrow">{copy.docsLabel}</p><h2 id="docs-title">{copy.docsTitle}</h2></div>
      <div class="docs-copy"><p>{copy.docsBody}</p><a class="primary-button" href={guide}>{copy.docsLink} <span aria-hidden="true">↗</span></a><a class="contribute-link" href={`${repo}/blob/main/docs/site/README.md`}>{copy.contribute} <span aria-hidden="true">↗</span></a></div>
      <span class="docs-decoration" aria-hidden="true">↗</span>
    </section>
  </main>

  <footer class="product-footer"><div><Brand href={home} /><p>{copy.footer}</p></div><nav aria-label="Footer"><a href={repo}>{copy.code} <span aria-hidden="true">↗</span></a><a href={`${repo}/blob/main/LICENSE`}>{copy.license}</a><a href={desktopRelease.url}>v{desktopRelease.version}</a></nav><span class="footer-signature">BY ALPHATESTER</span></footer>

  <dialog id="studio-preview" class="studio-dialog" aria-labelledby="studio-caption"><button data-close-studio aria-label={copy.close}>×</button><Image src={studio} alt={copy.imageAlt} width={2000} format="webp" quality={90} loading="lazy" /><p id="studio-caption">{copy.imageSource}</p></dialog>
</div>

<script>
  const preview = document.querySelector<HTMLDialogElement>("#studio-preview");
  document.querySelector("[data-open-studio]")?.addEventListener("click", () => preview?.showModal());
  document.querySelector("[data-close-studio]")?.addEventListener("click", () => preview?.close());
  preview?.addEventListener("click", (event) => { if (event.target === preview) preview.close(); });
</script>
